{
  "name": "@geek-fun/serverless-adapter",
  "version": "0.2.10",
  "description": "Run Express, Koa, and Hono apps on serverless across clouds: Aliyun FC, Tencent SCF, Volcengine veFaaS, AWS Lambda, and Cloudflare Workers, with automatic provider detection.",
  "homepage": "https://www.geekfun.club/",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles --coverage --coverageReporters json-summary text html lcov",
    "test:ci": "jest --runInBand --ci --coverage --coverageReporters json-summary text html lcov",
    "build": "tsc --build",
    "lint:fix": "eslint --fix ./",
    "lint:check": "eslint ./",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geek-fun/serverless-adapter.git"
  },
  "author": "geekfun <support@geekfun.club>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/geek-fun/serverless-adapter/issues"
  },
  "keywords": [
    "serverless",
    "express",
    "koa",
    "hono",
    "lambda",
    "aws-lambda",
    "cloudflare-workers",
    "aliyun",
    "alibaba-cloud",
    "function-compute",
    "tencent-cloud",
    "scf",
    "volcengine",
    "vefaas",
    "api-gateway",
    "typescript",
    "nodejs",
    "http",
    "adapter"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "raw-body": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@koa/router": "^13.1.1",
    "@types/debug": "^4.1.13",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.5",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "body-parser": "^1.20.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "express4": "npm:express@^4.22.1",
    "express5": "npm:express@^5.2.1",
    "globals": "^15.15.0",
    "hono": "^4.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "koa-body": "^6.0.1",
    "koa-static": "^5.0.0",
    "koa2": "npm:koa@^2.16.4",
    "koa3": "npm:koa@^3.1.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
